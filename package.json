{
  "name": "xlcalc-sheet",
  "version": "0.11.0",
  "description": "Vue 3 sheet component for xlcalc workbooks: a windowed grid with styles, formulas and editing over a pluggable sheet source",
  "license": "MIT",
  "author": "Mikhail Kostryukov",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./local": {
      "types": "./dist/local/index.d.ts",
      "default": "./dist/local.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.local.config.ts && vue-tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "pack:release": "npm run build && npm pack --pack-destination release",
    "dev:example": "vite --config vite.example.config.ts",
    "build:example": "vite build --config vite.example.config.ts",
    "build:demo": "vite build --config vite.example.config.ts --mode demo",
    "screens": "node scripts/screens.ts",
    "check:local": "node scripts/local-check.ts",
    "check:spa": "node scripts/spa-check.ts",
    "check:big": "node scripts/big-check.ts",
    "check:excel-values": "node scripts/excel-values.ts",
    "check:compare-values": "node scripts/compare-values.ts"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "xlcalc": ">=0.31.0"
  },
  "peerDependenciesMeta": {
    "xlcalc": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.0",
    "playwright": "1.63.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.5",
    "xlcalc": "file:vendor/xlcalc-0.33.0.tgz"
  }
}
